rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Iedereen kan gepubliceerde routes lezen
    match /routes/{routeId} {
      allow read: if resource.data.gepubliceerd == true;
      allow write: if request.auth != null && isAdmin();

      match /waypoints/{waypointId} {
        allow read: if get(/databases/$(database)/documents/routes/$(routeId)).data.gepubliceerd == true;
        allow write: if request.auth != null && isAdmin();
      }
    }

    // Alleen admins kunnen alles lezen/schrijven
    match /routes/{routeId} {
      allow read, write: if request.auth != null && isAdmin();
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
