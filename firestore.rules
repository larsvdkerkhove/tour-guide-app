rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Gepubliceerde routes zijn publiek leesbaar; schrijven enkel voor admins
    match /routes/{routeId} {
      allow read: if resource.data.gepubliceerd == true || (request.auth != null && isAdmin());
      allow write: if request.auth != null && isAdmin();

      match /waypoints/{waypointId} {
        allow read: if get(/databases/$(database)/documents/routes/$(routeId)).data.gepubliceerd == true
                    || (request.auth != null && isAdmin());
        allow write: if request.auth != null && isAdmin();
      }
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
